# Image3DConversion — environment template (copy to .env.local; never commit real values).
#
# Keep ONE block per variable. If a key appears twice in .env.local the LAST
# occurrence silently wins, so a stale "safe" value above a live one gives a
# false sense of what the dev server is actually loading.
#
# ── Keystatic CMS admin protection (/keystatic) ────────────────────────────
# Development: the admin is always reachable locally (no vars needed).
# Production: the admin is 404 by default. To expose it in production you MUST
# set ALL THREE below — enabling without credentials still 404s (fail-safe).
# Access is then gated by HTTP Basic Auth.
KEYSTATIC_ENABLED=false
KEYSTATIC_ADMIN_USER=
KEYSTATIC_ADMIN_PASSWORD=
#
# ── Zoho CRM (enquiry intake) ──────────────────────────────────────────────
# Live submission is OFF until ZOHO_SUBMIT_ENABLED=true AND all creds are set.
# Until then /api/enquiry runs in DRY-RUN: it validates + logs, sends nothing.
# Credentials are read server-side only and never reach the browser bundle.
#
# A local dev server is ALWAYS forced to dry-run, even with the flag on and real
# credentials present — see ZOHO_ALLOW_LOCAL_LIVE at the bottom of this file.
# The local default below must stay false.
#
# Region hosts: .in (India), .com (US), .eu, .com.au, .jp — match your Zoho DC.
ZOHO_SUBMIT_ENABLED=false
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Target module: Leads (recommended) — or a purpose-built module once decided.
ZOHO_MODULE=Leads
# Optional: id of the "I3DC Website" Leads layout (created in Zoho; id
# 6607227000004071789). When set, new leads are filed under this layout.
ZOHO_LAYOUT_ID=
#
# ── Local-only escape hatch ────────────────────────────────────────────────
# `npm run dev` is forced to DRY-RUN regardless of the flag above, so routine
# local work on the enquiry form cannot create real CRM leads. Set this to true
# ONLY for a deliberate, supervised local live test; every submission then logs
# a [enquiry:LOCAL-LIVE] warning. Unset it again immediately afterwards.
#
# NEVER set this in Vercel. It has no effect on a production build (the guard it
# overrides cannot fire there), and setting it only obscures intent.
ZOHO_ALLOW_LOCAL_LIVE=false
#
# ── Meta Pixel + Conversions API (dataset "I3DC Services — image3dconversion.com") ──
# INERT until META_TRACKING_ENABLED=true. While off: no Pixel is rendered, no
# consent banner appears, no event id is derived and nothing is sent to Meta.
# Even when on, nothing reaches Meta until the visitor chooses ALLOW.
#
# The Pixel id MUST be exactly 1788653802312623. Any other value (e.g. a legacy
# SurgiGuide/workshop Pixel) is refused and tracking stays off.
# The browser Pixel and the server CAPI always use this same dataset.
#
# Static pages bake the Pixel gate in at BUILD time: changing these values in
# Vercel requires a redeploy to take effect.
META_TRACKING_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=1788653802312623
#
# Server CAPI delivery: OFF (default), TEST_EVENTS (Vercel Preview only, needs
# META_TEST_EVENT_CODE) or LIVE (Vercel Production only, separately approved).
META_CAPI_DELIVERY=OFF
#
# SERVER-ONLY secrets. Never prefix with NEXT_PUBLIC_, never commit a value, never
# log them. META_EVENT_ID_SECRET is an I3DC-only HMAC key of 32+ characters; it
# derives event ids from website references, so keep it stable once in use.
META_CAPI_ACCESS_TOKEN=
META_EVENT_ID_SECRET=
#
# UAT ONLY — Meta Events Manager → Test Events code (e.g. TEST12345). Preview scope
# only. On Production it fails the build and switches Meta off at runtime.
# Note: Meta still records test events — they are not discarded.
META_TEST_EVENT_CODE=
#
# Server-held synthetic/test classification (lib/meta/synthetic). A synthetic
# submission can only ever reach Meta as a Test Event.
META_SYNTHETIC_EMAILS=
META_SYNTHETIC_KEY=
#
# ── Local-only Meta test harness ───────────────────────────────────────────
# A `next dev` server NEVER sends anything to Meta, even with the values above
# copied in. META_ALLOW_LOCAL_TRACKING=true lets the Pixel render locally, and
# CAPI then goes ONLY to a loopback fake named by META_GRAPH_API_BASE (e.g.
# http://127.0.0.1:4373). Used by tests/browser/meta-tracking.mjs.
# NEVER set either in Vercel: a production build ignores both, always sends to
# graph.facebook.com, and cannot be pointed at any other host.
META_ALLOW_LOCAL_TRACKING=false
META_GRAPH_API_BASE=
